    <string name="provider_groq_free_name">Groq (gratis)</string>
    <string name="provider_groq_free_offer">Gratis siempre, con límite: ~2 h de audio por hora y ~8 h por día. Archivos de hasta 25 MB.</string>
    <string name="provider_groq_free_step_1">Entra a console.groq.com y crea tu cuenta (correo o Google).</string>
    <string name="provider_groq_free_step_2">Ve a «API Keys» y pulsa «Create API Key».</string>
    <string name="provider_groq_free_step_3">Copia la llave (empieza con gsk_) y pégala aquí.</string>
    <string name="provider_groq_free_meter">Dato real: Groq lo informa en cada transcripción. Se renueva solo cada hora/día.</string>
    <string name="provider_inworld_name">Inworld (gratis)</string>
    <string name="provider_inworld_offer">Hasta 400 min de STT gratis una vez (plan On-Demand, $0). Archivos de hasta ~16 MB.</string>
    <string name="provider_inworld_step_1">Entra a platform.inworld.ai y crea tu cuenta.</string>
    <string name="provider_inworld_step_2">Ve a Manage → API Keys → Create Inworld API key (tipo Standard).</string>
    <string name="provider_inworld_step_3">Copia la llave con «Copy key» (ya viene en Basic/Base64) y pégala aquí.</string>
    <string name="provider_inworld_meter">Estimado: bolsa única de ~400 min; la app suma lo que transcribes. Corrígelo si tu panel de Inworld dice otra cosa.</string>
    <string name="provider_assembly_name">AssemblyAI (crédito de regalo)</string>
    <string name="provider_assembly_offer">Crédito de regalo una sola vez ($50 USD al momento de publicar), sin tarjeta y sin vencimiento.</string>
    <string name="provider_assembly_step_1">Entra a assemblyai.com y crea tu cuenta (no pongas tarjeta).</string>
    <string name="provider_assembly_step_2">En el panel principal verás tu API Key.</string>
    <string name="provider_assembly_step_3">Cópiala y pégala aquí.</string>
    <string name="provider_assembly_meter">Estimado: AssemblyAI no informa el saldo a la app. Escribe abajo el saldo que ves en tu panel para corregirlo.</string>
    <string name="provider_deepgram_name">Deepgram (crédito de regalo)</string>
    <string name="provider_deepgram_offer">Crédito de regalo una sola vez ($200 USD al momento de publicar), sin tarjeta.</string>
    <string name="provider_deepgram_step_1">Entra a console.deepgram.com y crea tu cuenta (no pongas tarjeta).</string>
    <string name="provider_deepgram_step_2">Ve a «API Keys» → «Create a New API Key».</string>
    <string name="provider_deepgram_step_3">Para ver el saldo real, dale rol «Admin» o «Owner» a la llave.</string>
    <string name="provider_deepgram_step_4">Cópiala y pégala aquí. El Project ID se vincula solo.</string>
    <string name="provider_deepgram_meter">Dato real si la llave tiene permiso de facturación; si no, la app estima con su propio contador.</string>
    <string name="provider_paid_name">Respaldo de pago (opcional)</string>
    <string name="provider_paid_offer">Aquí SÍ pagas. Solo se usa si apagas «Modo $0» y todos los gratuitos fallaron.</string>
    <string name="provider_paid_step_1">Opción A · Groq de pago: activa facturación en console.groq.com y crea una llave.</string>
    <string name="provider_paid_step_2">Opción B · Microsoft (Azure): crea un recurso de voz en Azure y copia su llave y endpoint.</string>
