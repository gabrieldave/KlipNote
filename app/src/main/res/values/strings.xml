    <!-- Provider catalog -->
    <string name="provider_groq_free_name">Groq (free)</string>
    <string name="provider_groq_free_offer">Always free with limits: ~2 h of audio per hour and ~8 h per day. Files up to 25 MB.</string>
    <string name="provider_groq_free_step_1">Go to console.groq.com and create an account (email or Google).</string>
    <string name="provider_groq_free_step_2">Open “API Keys” and tap “Create API Key”.</string>
    <string name="provider_groq_free_step_3">Copy the key (starts with gsk_) and paste it here.</string>
    <string name="provider_groq_free_meter">Live data: Groq reports it on each transcription. It renews every hour/day.</string>
    <string name="provider_inworld_name">Inworld (free)</string>
    <string name="provider_inworld_offer">Up to 400 min of free STT once (On-Demand plan, $0). Files up to ~16 MB.</string>
    <string name="provider_inworld_step_1">Go to platform.inworld.ai and create an account.</string>
    <string name="provider_inworld_step_2">Open Manage → API Keys → Create Inworld API key (Standard type).</string>
    <string name="provider_inworld_step_3">Copy the key with “Copy key” (already Basic/Base64) and paste it here.</string>
    <string name="provider_inworld_meter">Estimated: one ~400 min bag; the app adds what you transcribe. Correct it if your Inworld panel says otherwise.</string>
    <string name="provider_assembly_name">AssemblyAI (gift credit)</string>
    <string name="provider_assembly_offer">One-time gift credit ($50 USD at publish time), no card and no expiry.</string>
    <string name="provider_assembly_step_1">Go to assemblyai.com and create an account (do not add a card).</string>
    <string name="provider_assembly_step_2">Your API Key appears on the main dashboard.</string>
    <string name="provider_assembly_step_3">Copy it and paste it here.</string>
    <string name="provider_assembly_meter">Estimated: AssemblyAI does not report balance to the app. Type the balance from your panel below to correct it.</string>
    <string name="provider_deepgram_name">Deepgram (gift credit)</string>
    <string name="provider_deepgram_offer">One-time gift credit ($200 USD at publish time), no card.</string>
    <string name="provider_deepgram_step_1">Go to console.deepgram.com and create an account (do not add a card).</string>
    <string name="provider_deepgram_step_2">Open “API Keys” → “Create a New API Key”.</string>
    <string name="provider_deepgram_step_3">For live balance, give the key “Admin” or “Owner” role.</string>
    <string name="provider_deepgram_step_4">Copy it and paste it here. Project ID links automatically.</string>
    <string name="provider_deepgram_meter">Live data if the key has billing permission; otherwise the app estimates with its own counter.</string>
